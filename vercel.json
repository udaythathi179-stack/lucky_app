{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "{frontend/**,index.html,styles.css,app.js,manifest.json,sw.js,logo.png,logo.jpg,favicon.png,favicon.ico,icon-192.png,icon-512.png,theme-bg.jpg,wave-theme.jpg,images/**,data/**}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/artist-discography",
      "dest": "/backend/api/artist-discography.js"
    },
    {
      "src": "/api/search",
      "dest": "/backend/api/search.js"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/backend/api/auth.js"
    },
    {
      "src": "/api/auth",
      "dest": "/backend/api/auth.js"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "Content-Type": "application/manifest+json",
        "Cache-Control": "no-cache, must-revalidate"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "/sw.js",
      "headers": {
        "Service-Worker-Allowed": "/",
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/sw.js"
    },
    {
      "src": "^/$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/index\\.html$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/(styles\\.css|app\\.js|logo\\.png|logo\\.jpg|favicon\\.png|favicon\\.ico|icon-192\\.png|icon-512\\.png|wave-theme\\.jpg)$",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      },
      "dest": "/$1"
    },
    {
      "src": "^/images/(avatar-uday\\.jpg|user-avatar\\.jpg)$",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      },
      "dest": "/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
