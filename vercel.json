{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/artist-discography",
      "dest": "/backend/api/artist-discography.js"
    },
    {
      "src": "/api/search",
      "dest": "/backend/api/search.js"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/backend/api/auth.js"
    },
    {
      "src": "/api/auth",
      "dest": "/backend/api/auth.js"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "Content-Type": "application/manifest+json"
      },
      "dest": "/frontend/manifest.json"
    },
    {
      "src": "/sw.js",
      "headers": {
        "Service-Worker-Allowed": "/",
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/frontend/sw.js"
    },
    {
      "src": "^/frontend/(.*)$",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
