{
  "version": 2,
  "builds": [
    {
      "src": "api/search.js",
      "use": "@vercel/node"
    },
    {
      "src": "{index.html,styles.css,app.js,manifest.json,sw.js,logo.png,favicon.png,icon-192.png,icon-512.png,.well-known/web-app-origin-association}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/search",
      "dest": "/api/search.js"
    },
    {
      "src": "/.well-known/web-app-origin-association",
      "dest": "/.well-known/web-app-origin-association"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "Content-Type": "application/manifest+json"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
