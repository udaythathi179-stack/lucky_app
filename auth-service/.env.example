spring.datasource.url=jdbc:mysql://localhost:3306/tuneus_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
spring.datasource.username=tuneus
spring.datasource.password=tuneus

JWT_SECRET=replace-with-openssl-rand-base64-48
JWT_ISSUER=tuneus-auth
JWT_AUDIENCE=tuneus-web
ACCESS_TOKEN_TTL=PT1H
REFRESH_TOKEN_TTL=P30D

REFRESH_COOKIE_NAME=tuneus_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
