# Public OAuth Web Client ID from Google Cloud Console.
# This is not a secret. Never place the Google client secret in frontend code.
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Leave blank to use the Vite dev proxy (/api -> http://localhost:8080).
# For separate deployments, set the API origin, e.g. https://api.example.com
VITE_API_BASE_URL=
